# ──────────────────────────────────────────────────────────────
# OpenReel Studio configuration
# Everything here is optional — sensible defaults are built in.
# Most options can also be changed at runtime on the Settings page.
# ──────────────────────────────────────────────────────────────

# Web server
PORT=3000
HOST=127.0.0.1

# Which engine generates video: auto | comfyui | local | external
#   auto     = ComfyUI if it is running, otherwise the local Python model worker
VIDEO_PROVIDER=auto

# ── ComfyUI (primary local engine) ──
COMFYUI_URL=http://127.0.0.1:8188
# Optional: folder where ComfyUI is installed. start.bat uses it to launch ComfyUI for you.
COMFYUI_PATH=

# ── Local Python model worker (diffusers, runs open-source models directly) ──
# Python interpreter; setup creates .venv automatically.
PYTHON_PATH=
# Hugging Face model id or local folder (diffusers format).
# Lightricks/LTX-Video is the fastest open model (text- and image-to-video).
LOCAL_MODEL=Lightricks/LTX-Video
# Where downloaded model weights are cached (default: ./models)
MODELS_DIR=

# ── Optional external provider (disabled unless a token is set) ──
# Replicate-compatible predictions API. Costs money per generation — off by default.
EXTERNAL_API_TOKEN=
EXTERNAL_API_URL=https://api.replicate.com/v1
EXTERNAL_MODEL=lightricks/ltx-video

# ── Optional local LLM prompt enhancer (Ollama, free). Rule-based enhancer is used when unset/offline.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# ── Text-to-speech (auto | piper | sapi | espeak | say) ──
TTS_ENGINE=auto
# Piper voice model (.onnx). Download free voices from https://github.com/rhasspy/piper
PIPER_PATH=
PIPER_VOICE=

# FFmpeg binaries (leave empty if ffmpeg is on PATH)
FFMPEG_PATH=
FFPROBE_PATH=
