# Haal je TEST keys op via https://dashboard.stripe.com/test/apikeys
# Gebruik NOOIT live keys (sk_live_...) in dit leerproject.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Vul in met de signing secret die "stripe listen" print (zie README)
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=3000
BASE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Free AI video studio (/studio)
# ---------------------------------------------------------------
# Where the self-hosted video engine (image-to-video/backend) runs.
ENGINE_URL=http://127.0.0.1:8000
# Shared secret with the engine. Required when the engine runs on another machine
# (must match ENGINE_API_TOKEN in image-to-video/.env). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ENGINE_API_TOKEN=
