# ---------------------------------------------------------------
# Local Image-to-Video — configuration (copy to .env)
# Everything runs locally. No API keys are needed.
# ---------------------------------------------------------------

# Local ComfyUI API (runs the open-source video models). In Docker use http://host.docker.internal:8188
COMFYUI_URL=http://127.0.0.1:8188
# Give up on a single generation after this many seconds
COMFYUI_TIMEOUT_SECONDS=10800
# Privacy: images are only sent to a localhost / LAN ComfyUI unless this is true
ALLOW_REMOTE_COMFYUI=false
# Generation on a CPU-only ComfyUI takes hours, so it is refused unless this is true
ALLOW_CPU_GENERATION=false
# Adds a "demo" slideshow model for UI testing. It is NOT AI video and is clearly labeled. Off by default.
ENABLE_DEMO_MODE=false

# Shared secret: the website must send it (set the same value in the site's .env).
# Always set it if this engine is reachable from other machines.
ENGINE_API_TOKEN=

# Storage (relative paths are relative to the project folder)
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
WORKFLOWS_DIR=workflows
# SQLite history database lives here
DATA_DIR=data
MAX_UPLOAD_MB=20
# Uploaded source images are deleted after this many hours
FILE_TTL_HOURS=24
# Generated videos stay in the history this many days
HISTORY_TTL_DAYS=7
CLEANUP_INTERVAL_MINUTES=30

# Frontend dev server origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: path to ffmpeg. Empty = system ffmpeg on PATH, else the bundled imageio-ffmpeg binary
FFMPEG_PATH=

# How many videos may be generated at the same time (1 is best for a single GPU)
MAX_CONCURRENT_JOBS=1
# Maximum variations per request
MAX_VARIATIONS=4
