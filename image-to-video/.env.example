# ---------------------------------------------------------------
# Local Image-to-Video — configuration (copy to .env)
# Everything runs locally. No API keys are needed.
# ---------------------------------------------------------------

# Video engine: auto | comfyui | mock
#   auto    = use ComfyUI when reachable, otherwise the mock slideshow
#   comfyui = only ComfyUI (shows setup instructions if unavailable)
#   mock    = Ken Burns slideshow for UI testing (NOT AI video)
VIDEO_PROVIDER=auto

# Local ComfyUI API. In Docker use http://host.docker.internal:8188
COMFYUI_URL=http://127.0.0.1:8188
# Workflow files (API format) inside ./workflows
COMFYUI_WORKFLOW=wan2.1_i2v_480p_api.json
COMFYUI_WORKFLOW_TWO_IMAGES=wan2.1_flf2v_720p_api.json
# Give up after this many seconds; progress bar assumes a typical run length
COMFYUI_TIMEOUT_SECONDS=1800
COMFYUI_EXPECTED_SECONDS=600
# Privacy: images are only sent to localhost / LAN ComfyUI unless this is true
ALLOW_REMOTE_COMFYUI=false

# Storage (relative paths are relative to the project folder)
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
WORKFLOWS_DIR=workflows
MAX_UPLOAD_MB=20
# Uploaded images and generated videos are deleted after this many hours
FILE_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Frontend dev server origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: path to ffmpeg. Empty = system ffmpeg on PATH, else the bundled imageio-ffmpeg binary
FFMPEG_PATH=

# How many videos may be generated at the same time (1 is best for a single GPU)
MAX_CONCURRENT_JOBS=1
